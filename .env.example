# Comma-separated CCXT spot exchange IDs.
ARB_EXCHANGES=binance,kraken,okx,bybit,gate

# Market scan sizing and cadence.
ARB_MAX_PAIRS=20
ARB_BOOK_DEPTH=20
ARB_SCAN_INTERVAL_SECONDS=10
ARB_QUOTE_BUDGET=100

# These are user-supplied cost inputs; zero means the cost is not modeled.
ARB_REBALANCE_COST_QUOTE=0
ARB_LATENCY_BUFFER_BPS=0
ARB_MAX_BOOK_SKEW_MS=1500

# Optional account-specific taker rates; replace with values from your accounts.
# Example: {"binance":"0.001","kraken":"0.008"}
ARB_TAKER_FEES_JSON={}

# Optional HTTP proxy. For 0dcloud, try http://127.0.0.1:17891.
# Keep this empty on a VPS unless that host has a proxy configured.
ARB_HTTP_PROXY=
